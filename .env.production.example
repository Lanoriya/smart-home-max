# Copy these values to a secret store or to the environment of the VDS.
# Do not commit the resulting file and do not reuse the local demonstration values.
# Public domain without https://. Example: dispatcher.example.org
APP_DOMAIN=dispatcher.example.org
POSTGRES_DB=smart_home
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://app:REPLACE_WITH_LONG_RANDOM_PASSWORD@db:5432/smart_home?schema=public
RESIDENT_UK_CODE=REPLACE_WITH_10_DIGITS
APARTMENT_CODE_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_SEED_USERNAME=dispatcher
ADMIN_SEED_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
MAX_MODE=api
MAX_RECEIVE_MODE=webhook
MAX_BOT_TOKEN=REPLACE_WITH_MAX_TOKEN
MAX_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET
MAX_PUBLIC_WEBHOOK_URL=https://dispatcher.example.org/webhooks/max
ADMIN_COOKIE_SECURE=true
ADMIN_WEB_ORIGIN=https://dispatcher.example.org
TRUST_PROXY_HOPS=2
