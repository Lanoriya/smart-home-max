NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:change-me@localhost:5432/smart_home?schema=public
POSTGRES_DB=smart_home
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# fake: локальная разработка без сетевых вызовов; api: реальные вызовы MAX
MAX_MODE=fake
# polling: запуск прямо с компьютера; webhook: публичный production; none: только отправка
MAX_RECEIVE_MODE=none
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=change-me-webhook-secret
MAX_PUBLIC_WEBHOOK_URL=https://example.ru/webhooks/max
APARTMENT_CODE_PEPPER=change-me-apartment-code-pepper
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_SECURE=false
TRUST_PROXY_HOPS=1

# Мини-приложение MAX
# Публичный ник бота без @: нужен для кнопок «Открыть приложение» и ссылок-приглашений
MAX_BOT_USERNAME=
# MAX user_id главных администраторов платформы через запятую
PLATFORM_ADMIN_MAX_USER_IDS=
# Только для локальной разработки: вход в мини-приложение в обычном браузере
# по адресу http://localhost:8080/app/?dev=<MAX user_id>. В production запрещено
MINIAPP_DEV_AUTH=false
# Как бот открывает приложение: open_app — мини-приложение, зарегистрированное
# для бота в «MAX для бизнеса»; link — персональная ссылка на MINIAPP_URL со
# входом на 24 часа (пока мини-приложение не зарегистрировано)
MINIAPP_OPEN_MODE=open_app
MINIAPP_URL=

ADMIN_WEB_ORIGIN=http://localhost:5173
# Локальный порт диспетчерской в Docker (по умолчанию 8080)
ADMIN_WEB_PORT=8080
VITE_API_BASE_URL=
